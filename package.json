{
  "name": "43files-workspace",
  "version": "1.0.0",
  "description": "43 แฟ้ม HDC/OPPP Data Submission Tracking Dashboard - Workspace Root",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "server": "npm run dev --workspace=server",
    "client": "npm run dev --workspace=client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build:server && npm run build:client",
    "install:server": "npm install --workspace=server",
    "install:client": "npm install --workspace=client",
    "install:all": "npm install"
  },
  "keywords": [
    "dashboard",
    "healthcare",
    "hdc",
    "oppp",
    "workspace"
  ],
  "author": "Phitsanulok Provincial Health Office",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}